PUBLIC_SITE_URL=https://example.com

# Envío del formulario de contacto (EmailJS). Estas llaves son públicas por
# diseño: van al bundle del cliente (prefijo PUBLIC_). Protéjalas con allowlist
# de dominios + reCAPTCHA + rate limiting en el panel de EmailJS.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# reCAPTCHA v2 Invisible — Site Key (pública). El Secret Key NO va aquí: se
# configura en el panel de EmailJS (integración reCAPTCHA).
PUBLIC_RECAPTCHA_SITE_KEY=
