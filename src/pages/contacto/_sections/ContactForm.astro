---
import { Icon } from "astro-icon/components";

import Button from "@components/ui/Button.astro";
import {
  formSubmitEndpoint,
  formSubmitAjaxEndpoint,
  contactAutoresponse,
} from "@config/site";

/*
  Formulario de contacto (Figma, Frame 43 · tarjeta derecha). Sitio estático en
  Cloudflare Pages: el envío se hace con FormSubmit en modo AJAX desde el
  navegador (fetch), así el usuario NO sale de la página y ve el estado de
  éxito/error dentro de la misma tarjeta. Sin captcha ni redirección.

  El `action` apunta al endpoint nativo solo como respaldo por si el JS no
  carga; con JS, el submit se intercepta y se envía por AJAX. Anti-spam:
  honeypot `_honey` + lista negra `_blacklist`. El alias (no el correo real) va
  en el endpoint para no exponer la dirección de destino. Ver docs/formsubmit.md.

  Estilos: Tailwind para layout/inputs/estados; CSS plano para el spinner, el
  honeypot y las animaciones de error/éxito (§5.2). Colores desde tokens (§12.3).
*/

const labelCls =
  "block text-[1.125rem] font-medium tracking-[-0.04em] text-ink";
const inputCls =
  "h-11 w-full rounded-[5px] border border-black/20 bg-white px-3.5 text-sm text-ink transition-colors placeholder:text-ink-secondary/50 focus:border-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/40 aria-[invalid=true]:border-critical aria-[invalid=true]:focus-visible:ring-critical/30";
const errCls = "ss-field-error mt-1 text-xs font-medium text-critical";
---

<form
  id="ss-contact-form"
  action={formSubmitEndpoint}
  method="POST"
  data-ajax={formSubmitAjaxEndpoint}
  novalidate
  class="rounded-control border border-black/20 bg-surface-muted p-6 shadow-[0_1px_4px_rgba(0,0,0,0.25)]"
>
  {/* --- Campos de control de FormSubmit (ocultos) --- */}
  <input
    type="hidden"
    name="_subject"
    value="Nuevo contacto desde el sitio web — Solution Systems"
  />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_autoresponse" value={contactAutoresponse} />
  <input
    type="hidden"
    name="_blacklist"
    value="SEO services, guest post, crypto, casino, backlink, viagra, loan offer"
  />

  {/* Honeypot: fuera de pantalla, oculto a lectores y al tabulador. */}
  <div class="ss-hp" aria-hidden="true">
    <label for="ss-honey">No completes este campo</label>
    <input
      id="ss-honey"
      name="_honey"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div id="ss-form-body" class="space-y-4">
    {/* Nombre + Apellido */}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <label for="nombre" class={labelCls}>Nombre</label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          required
          aria-required="true"
          autocomplete="given-name"
          placeholder="Nombre"
          class={`mt-1.5 ${inputCls}`}
          aria-describedby="err-nombre"
        />
        <p id="err-nombre" class={errCls} hidden></p>
      </div>

      <div>
        <label for="apellido" class={labelCls}>Apellido</label>
        <input
          id="apellido"
          name="apellido"
          type="text"
          required
          aria-required="true"
          autocomplete="family-name"
          placeholder="Apellido"
          class={`mt-1.5 ${inputCls}`}
          aria-describedby="err-apellido"
        />
        <p id="err-apellido" class={errCls} hidden></p>
      </div>
    </div>

    {/* Correo electrónico */}
    <div>
      <label for="email" class={labelCls}>Correo electrónico</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        aria-required="true"
        autocomplete="email"
        placeholder="nombre@dominio.com"
        class={`mt-1.5 ${inputCls}`}
        aria-describedby="err-email"
      />
      <p id="err-email" class={errCls} hidden></p>
    </div>

    {/* Número de teléfono (opcional) */}
    <div>
      <label for="telefono" class={labelCls}>Número de teléfono</label>
      <input
        id="telefono"
        name="telefono"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+57 123 456 7890"
        class={`mt-1.5 ${inputCls}`}
        aria-describedby="err-telefono"
      />
      <p id="err-telefono" class={errCls} hidden></p>
    </div>

    {/* Empresa (opcional) */}
    <div>
      <label for="empresa" class={labelCls}>Empresa (opcional)</label>
      <input
        id="empresa"
        name="empresa"
        type="text"
        autocomplete="organization"
        placeholder="Nombre de empresa"
        class={`mt-1.5 ${inputCls}`}
      />
    </div>

    {/* Mensaje */}
    <div>
      <div class="flex items-center justify-between">
        <label for="mensaje" class={labelCls}>Mensaje</label>
        <span
          id="ss-counter"
          class="text-ink-secondary/70 text-xs tabular-nums"
          aria-hidden="true">0/1000</span
        >
      </div>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="4"
        required
        aria-required="true"
        maxlength="1000"
        placeholder="Cuéntanos cómo podemos ayudarte…"
        class={`mt-1.5 min-h-[107px] resize-y py-2.5 ${inputCls} h-auto`}
        aria-describedby="err-mensaje"></textarea>
      <p id="err-mensaje" class={errCls} hidden></p>
    </div>

    {/* Autorización de tratamiento de datos (Ley 1581 de 2012).
        El `value` viaja en el correo como constancia del consentimiento. */}
    <div>
      <div class="flex items-start gap-2.5">
        <input
          id="autorizacion"
          name="autorizacion"
          type="checkbox"
          required
          aria-required="true"
          value="Sí, autorizó el tratamiento de datos (Ley 1581 de 2012)"
          class="accent-brand focus-visible:outline-brand mt-0.5 size-4 shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2"
          aria-describedby="err-autorizacion"
        />
        <label for="autorizacion" class="text-ink-secondary text-sm leading-snug">
          Autorizo el tratamiento de mis datos personales conforme a la{" "}
          <a
            href="/politica-de-privacidad"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand underline underline-offset-2"
          >
            Política de privacidad
          </a>.
        </label>
      </div>
      <p id="err-autorizacion" class={errCls} hidden></p>
    </div>

    {/* Estado del envío (errores) */}
    <div
      id="ss-status"
      role="status"
      aria-live="polite"
      class="text-sm font-medium"
      hidden
    >
    </div>

    <div class="flex justify-end">
      <Button
        type="submit"
        variant="primary"
        size="md"
        id="ss-submit"
        class="w-full disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
      >
        Enviar mensaje
      </Button>
    </div>
  </div>

  {/* Estado de carga: reemplaza el formulario mientras se envía. */}
  <div
    id="ss-loading"
    role="status"
    class="flex flex-col items-center justify-center px-6 py-16"
    hidden
  >
    <span class="ss-spinner-lg" aria-hidden="true"></span>
    <span class="sr-only">Enviando tu mensaje…</span>
  </div>

  {/* Estado de éxito: reemplaza el formulario dentro de la misma tarjeta. */}
  <div
    id="ss-success"
    role="status"
    tabindex="-1"
    class="ss-success flex flex-col items-center justify-center px-6 py-14 text-center outline-none"
    hidden
  >
    <span class="ss-success-icon text-chart-3" aria-hidden="true">
      <Icon name="lucide:mail-check" class="size-16" />
    </span>
    <p class="text-ink mt-6 max-w-[340px] text-[1.125rem] leading-snug font-medium">
      ¡Gracias! Tu mensaje fue enviado. Te responderemos lo antes posible.
    </p>
  </div>
</form>

<style>
  /* Honeypot: fuera de la pantalla, nunca `display:none` (los bots lo omitirían). */
  .ss-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Ruedita del estado `loading` (centrada en la tarjeta). */
  .ss-spinner-lg {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid color-mix(in srgb, var(--color-brand) 22%, transparent);
    border-top-color: var(--color-brand);
    border-radius: 50%;
    animation: ss-spin 0.7s linear infinite;
  }

  /* Entrada suave de los mensajes de error al aparecer. */
  .ss-field-error:not([hidden]) {
    animation: ss-error-in 0.18s ease-out;
  }

  /* Aparición del ícono del estado de éxito. */
  .ss-success-icon {
    display: inline-flex;
  }
  .ss-success:not([hidden]) .ss-success-icon {
    animation: ss-success-in 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes ss-success-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ss-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes ss-error-in {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const form = document.getElementById(
    "ss-contact-form",
  ) as HTMLFormElement | null;

  if (form) {
    const AJAX_ENDPOINT = form.dataset.ajax ?? "";
    const CONTACT_EMAIL = "servcliente@e-solutionsystems.net";

    const statusEl = document.getElementById("ss-status") as HTMLElement;
    const formBody = document.getElementById("ss-form-body") as HTMLElement;
    const loadingPanel = document.getElementById("ss-loading") as HTMLElement;
    const successPanel = document.getElementById("ss-success") as HTMLElement;
    const submitBtn = document.getElementById("ss-submit") as HTMLButtonElement;
    const counter = document.getElementById("ss-counter") as HTMLElement;
    const mensaje = form.elements.namedItem("mensaje") as HTMLTextAreaElement;
    const honeypot = form.elements.namedItem("_honey") as HTMLInputElement;

    // Validadores por campo. Devuelven el mensaje de error o `null` si es válido.
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phoneRe = /^[0-9+\-\s()]{7,20}$/;
    const rules: Record<string, (value: string) => string | null> = {
      nombre: (v) => (v.trim().length >= 2 ? null : "Ingresa tu nombre."),
      apellido: (v) => (v.trim().length >= 2 ? null : "Ingresa tu apellido."),
      email: (v) =>
        emailRe.test(v.trim()) ? null : "Ingresa un correo electrónico válido.",
      telefono: (v) =>
        v.trim() === "" || phoneRe.test(v.trim())
          ? null
          : "Ingresa un número de teléfono válido.",
      mensaje: (v) => {
        const t = v.trim();
        if (t.length < 20) return "El mensaje debe tener al menos 20 caracteres.";
        if (t.length > 1000)
          return "El mensaje no puede superar los 1000 caracteres.";
        return null;
      },
    };

    const setFieldError = (name: string, message: string | null) => {
      const field = form.elements.namedItem(name) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      const errorEl = document.getElementById(`err-${name}`);
      if (!field || !errorEl) return;
      field.setAttribute("aria-invalid", message ? "true" : "false");
      errorEl.textContent = message ?? "";
      errorEl.hidden = !message;
    };

    const validateField = (name: string): boolean => {
      const field = form.elements.namedItem(name) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      if (!field) return true;
      const message = rules[name](field.value);
      setFieldError(name, message);
      return !message;
    };

    const validateCheckbox = (): boolean => {
      const checkbox = form.elements.namedItem(
        "autorizacion",
      ) as HTMLInputElement;
      const errorEl = document.getElementById("err-autorizacion");
      const ok = checkbox.checked;
      checkbox.setAttribute("aria-invalid", ok ? "false" : "true");
      if (errorEl) {
        errorEl.textContent = ok
          ? ""
          : "Debes autorizar el tratamiento de tus datos.";
        errorEl.hidden = ok;
      }
      return ok;
    };

    // Validación en `blur` de cada campo.
    Object.keys(rules).forEach((name) => {
      const field = form.elements.namedItem(name) as HTMLElement | null;
      field?.addEventListener("blur", () => validateField(name));
    });
    (
      form.elements.namedItem("autorizacion") as HTMLInputElement
    ).addEventListener("change", validateCheckbox);

    // Contador del mensaje.
    const updateCounter = () => {
      counter.textContent = `${mensaje.value.length}/1000`;
    };
    mensaje.addEventListener("input", updateCounter);

    // ---- Transiciones y estados ----
    // La ruedita se muestra al menos este tiempo aunque el envío sea instantáneo.
    const MIN_LOADING_MS = 1000;
    let submitting = false;

    const sleep = (ms: number) =>
      new Promise<void>((resolve) => setTimeout(resolve, ms));

    const fadeIn = (el: HTMLElement) => {
      el.hidden = false;
      el.style.opacity = "0";
      requestAnimationFrame(() => {
        el.style.transition = "opacity 300ms ease";
        el.style.opacity = "1";
      });
    };

    const fadeOut = (el: HTMLElement) =>
      new Promise<void>((resolve) => {
        el.style.transition = "opacity 200ms ease";
        el.style.opacity = "0";
        window.setTimeout(() => {
          el.hidden = true;
          el.style.removeProperty("opacity");
          el.style.removeProperty("transition");
          resolve();
        }, 200);
      });

    const showSuccess = async () => {
      await fadeOut(loadingPanel);
      fadeIn(successPanel);
      successPanel.focus();
    };

    const showError = async () => {
      await fadeOut(loadingPanel);
      submitBtn.disabled = false;
      fadeIn(formBody);
      statusEl.hidden = false;
      statusEl.classList.add("text-critical");
      statusEl.textContent = `No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos a ${CONTACT_EMAIL}.`;
    };

    // ---- Envío por AJAX (el usuario no sale de la página) ----
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return; // anti doble envío

      // Validación completa; enfoca el primer campo inválido.
      const order = ["nombre", "apellido", "email", "telefono", "mensaje"];
      let firstInvalid: string | null = null;
      for (const name of order) {
        if (!validateField(name) && !firstInvalid) firstInvalid = name;
      }
      const checkboxOk = validateCheckbox();
      if (!checkboxOk && !firstInvalid) firstInvalid = "autorizacion";

      if (firstInvalid) {
        (form.elements.namedItem(firstInvalid) as HTMLElement).focus();
        return;
      }

      // Estado de carga: la ruedita reemplaza el formulario.
      submitting = true;
      submitBtn.disabled = true;
      statusEl.hidden = true;
      statusEl.classList.remove("text-critical");
      formBody.hidden = true;
      fadeIn(loadingPanel);
      const startedAt = performance.now();

      try {
        // Honeypot: si viene lleno, no se envía, pero se simula éxito.
        if (honeypot.value === "") {
          const fd = new FormData(form);
          const payload: Record<string, string> = {};
          fd.forEach((value, key) => {
            payload[key] = typeof value === "string" ? value : "";
          });
          delete payload._honey;
          payload.telefono = payload.telefono?.trim() || "No proporcionado";
          payload.empresa = payload.empresa?.trim() || "No proporcionada";
          payload._replyto = payload.email;

          const res = await fetch(AJAX_ENDPOINT, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            throw new Error(`FormSubmit respondió ${res.status}`);
          }
        }

        // Mantiene la ruedita al menos MIN_LOADING_MS antes del mensaje.
        const remaining = MIN_LOADING_MS - (performance.now() - startedAt);
        if (remaining > 0) await sleep(remaining);

        form.reset();
        updateCounter();
        await showSuccess();
      } catch (error) {
        console.error("Error al enviar el formulario de contacto:", error);
        await showError();
      } finally {
        submitting = false;
      }
    });
  }
</script>
