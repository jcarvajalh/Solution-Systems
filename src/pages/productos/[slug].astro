---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductShowcase from "./_sections/ProductShowcase.astro";
import { products } from "@config/navigation";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

export interface Props {
  product: (typeof products)[number];
}

const { product } = Astro.props;
---

<BaseLayout
  title={product.name}
  description={`${product.name}: solución tecnológica de Solution Systems para el sector financiero.`}
>
  <ProductShowcase slug={product.slug} productName={product.name} />
</BaseLayout>
