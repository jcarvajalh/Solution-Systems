---
import { Image } from "astro:assets";

import Container from "@components/layout/Container.astro";
import Button from "@components/ui/Button.astro";
import { headerActions } from "@config/navigation";
import AccountsGallery from "./AccountsGallery.astro";
import FinancialGallery from "./FinancialGallery.astro";
import HumanGallery from "./HumanGallery.astro";

interface Props {
  /** Slug del producto; resuelve el copy real (contenido.md §3). */
  slug: string;
  /** Nombre del producto; titular del hero. */
  productName: string;
}

const { slug, productName } = Astro.props;

interface Feature {
  title: string;
  text: string;
  /** Slug del archivo en src/assets/images/products/ (sin extensión). */
  image?: string;
}

interface ProductContent {
  intro: string;
  features: Feature[];
}

/*
  Copy real por producto (contenido.md §3). Los productos que aún no tienen copy
  definido usan el respaldo genérico de más abajo.
  TODO: confirmar con Juan — copy real de RISK.
*/
const productContent: Record<string, ProductContent> = {
  "ias-financial": {
    intro:
      "Nuestro módulo de Análisis Presupuestal te permite visualizar de forma clara y dinámica el comportamiento de los ingresos o gastos, comparando lo apropiado frente a lo efectivamente ejecutado, mes a mes y año a año.",
    features: [
      {
        title: "Control",
        text: "FINANCIAL blinda tu operación financiera con controles automáticos de presupuesto, segregación de funciones, trazabilidad y validaciones cruzadas entre módulos, garantizando cumplimiento normativo y transparencia en cada transacción.",
        image: "financial-control",
      },
      {
        title: "Informes",
        text: "Con FINANCIAL, cada área cuenta con informes claros, actualizados y trazables, listos para auditorías, entes de control y toma de decisiones gerenciales, sin depender de reportes manuales ni hojas de cálculo dispersas.",
        image: "financial-informe",
      },
    ],
  },
  "ias-accounts": {
    intro:
      "Visualiza el recaudo total de tu cartera mes a mes, discriminado entre capital e intereses, dentro del rango de fechas que necesites. Una herramienta clara y ágil para el seguimiento financiero y la toma de decisiones de cobranza.",
    features: [
      {
        title: "Control",
        text: "ACCOUNTS incorpora controles automáticos sobre toda la operación de captación y colocación de recursos —cartera de créditos, depósitos a la vista y a plazo, e inversiones (CDT)—, garantizando el registro correcto de capital, intereses corrientes y de mora en cada operación. El sistema valida saldos, tasas y plazos de forma automática, evitando inconsistencias entre lo pactado y lo registrado, y asegura una trazabilidad completa de cada movimiento por línea de crédito o producto de captación, fortaleciendo el control interno y la confiabilidad de la información financiera.",
        image: "accounts-control",
      },
      {
        title: "Informes",
        text: "ACCOUNTS genera informes en tiempo real sobre saldos de cartera (capital, interés corriente e interés de mora), captaciones a la vista y a plazo, e inversiones vigentes, con comparativos año a año y desglose por línea de crédito. Esta información consolidada permite a la entidad monitorear la composición y evolución de su portafolio de manera ágil, soportar la toma de decisiones financieras y responder oportunamente a requerimientos de entes de control y auditoría.",
        image: "accounts-informe",
      },
    ],
  },
  "ias-human": {
    intro:
      "Centraliza la información clave del recurso humano de tu entidad en un solo lugar: planta de personal, vacantes, nómina, contratistas y capacitaciones, con indicadores de ejecución y cobertura actualizados a la fecha de corte. Una herramienta pensada para que las áreas de talento humano de entidades públicas tomen decisiones más ágiles y basadas en datos.",
    features: [
      {
        title: "Control",
        text: "HUMAN incorpora controles automáticos en cada etapa de la gestión de talento humano —liquidación de nómina, vacaciones, carrera administrativa, seguridad social, contratistas y horas extras—, asegurando el cumplimiento de la normatividad laboral y las políticas internas de la entidad. El sistema valida topes legales de horas extras, causación correcta de aportes a seguridad social, cálculo automático de vacaciones y prestaciones, y verifica los requisitos de la carrera administrativa antes de aprobar novedades, reduciendo errores manuales y previniendo contingencias laborales o sanciones ante entes de control.",
        image: "human-control",
      },
      {
        title: "Informes",
        text: "HUMAN genera informes en tiempo real sobre la nómina, novedades, seguridad social, vacaciones causadas y disfrutadas, contratistas vigentes y horas extras reconocidas, con comparativos por periodo y dependencia. Esta información consolidada facilita la rendición de cuentas ante organismos de control (Función Pública, UGPP, entre otros), apoya la planeación del gasto de personal y agiliza la toma de decisiones de la alta dirección en materia de talento humano.",
        image: "human-informe",
      },
    ],
  },
};

// Respaldo genérico para productos sin copy definido.
const fallbackIntro =
  "Solución tecnológica de Solution Systems sobre tecnología Oracle, con la cercanía y el respaldo técnico de un equipo especializado.";
const fallback: ProductContent = {
  intro: fallbackIntro,
  features: [
    { title: "Control", text: fallbackIntro },
    { title: "Informes", text: fallbackIntro },
  ],
};

const { intro, features } = productContent[slug] ?? fallback;

const cta = headerActions.primary; // "Empezar ahora"

/*
  Capturas reales por slug de archivo en src/assets/images/products/. Al soltar
  `<slug>.jpg` en esa carpeta y referenciarlo desde `feature.image` aparece
  automáticamente; mientras no exista se pinta el placeholder (mismo patrón que
  ServiceCards). Astro optimiza cada `<Image>` a formatos modernos.
*/
const productImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/products/*.{png,jpg,jpeg,webp}",
  { eager: true },
);
const imageBySlug = new Map(
  Object.entries(productImages).map(([path, mod]) => [
    path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, ""),
    mod.default,
  ]),
);

// Galería recreada (gráficas vectoriales) por producto; el resto usa placeholders.
const galleryBySlug: Record<string, typeof FinancialGallery> = {
  "ias-financial": FinancialGallery,
  "ias-accounts": AccountsGallery,
  "ias-human": HumanGallery,
};
const Gallery = galleryBySlug[slug];

// Placeholders de imagen (recuadros grises) pendientes de fotos reales.
const placeholderBox = "flex items-center justify-center bg-section-secondary";
const placeholderMarker =
  "border-hairline text-ink-secondary/60 rounded border border-dashed px-3 py-1.5 text-xs tracking-wide uppercase";
---

{/* Hero */}
<section
  class="ss-rails border-hairline border-t bg-white"
  aria-labelledby="producto-heading"
>
  <div class="border-hairline border-b">
    <Container class="py-16 text-center lg:py-24">
      <h1
        id="producto-heading"
        class="text-display text-ink font-semibold"
      >
        {productName}
      </h1>
      <p class="text-lead text-ink-secondary mx-auto mt-6 max-w-[813px] font-medium">
        {intro}
      </p>
      <div class="mt-8 flex justify-center">
        <Button variant="primary" size="md" href={cta.href}>
          {cta.label}
        </Button>
      </div>
    </Container>
  </div>

  {/* Galería de miniaturas: gráficas recreadas en IAS Financial; placeholders en el resto. */}
  <div>
    <Container class="py-10 lg:py-12">
      {
        Gallery ? (
          <Gallery />
        ) : (
          <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
            {Array.from({ length: 4 }).map(() => (
              <li class:list={[placeholderBox, "aspect-[252/163]"]} aria-hidden="true">
                <span class={placeholderMarker}>Imagen</span>
              </li>
            ))}
          </ul>
        )
      }
    </Container>
  </div>
</section>

{/* Bloques de características */}
<section class="ss-rails bg-surface-muted pb-24 lg:pb-36">
  <div class="space-y-10 lg:space-y-36">
    {
      features.map((feature, index) => {
        const featureImage = feature.image
          ? imageBySlug.get(feature.image)
          : undefined;

        return (
        // Banda full-width: los bordes superior/inferior (hairline) cruzan toda
        // la pantalla; la tarjeta blanca se centra al ancho del rail-frame.
        // La imagen alterna de lado en escritorio (par: izquierda; impar: derecha).
        <div class="border-hairline border-y">
          <article class="nav:max-w-[var(--rail-frame)] mx-auto w-full bg-white">
            <div class="flex flex-col lg:flex-row lg:items-stretch">
              {/* Imagen: captura real si existe; si no, placeholder. */}
              <div
                class:list={[
                  "border-hairline flex items-center justify-center p-3 lg:w-[54%] lg:shrink-0",
                  index % 2 === 0
                    ? "lg:border-r"
                    : "lg:order-2 lg:border-l",
                ]}
              >
                {featureImage ? (
                  <Image
                    src={featureImage}
                    alt={`Captura del producto: ${feature.title}`}
                    class="border-hairline w-full rounded border"
                    sizes="(min-width: 1024px) 640px, 100vw"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class:list={[placeholderBox, "aspect-[595/370] w-full"]}
                    aria-hidden="true"
                  >
                    <span class={placeholderMarker}>Imagen</span>
                  </div>
                )}
              </div>

              {/* Texto */}
              <div class="flex flex-1 flex-col items-start justify-center gap-6 px-8 py-10 lg:px-12 lg:py-12">
                <h2 class="text-ink text-[2rem] leading-[1.2] font-semibold tracking-[-0.04em] sm:text-[2.5rem] sm:leading-[1.3]">
                  {feature.title}
                </h2>
                <p class="text-lead text-ink-secondary max-w-[414px] font-medium">
                  {feature.text}
                </p>
                <Button variant="primary" size="md" href={cta.href}>
                  {cta.label}
                </Button>
              </div>
            </div>
          </article>
        </div>
        );
      })
    }
  </div>
</section>
