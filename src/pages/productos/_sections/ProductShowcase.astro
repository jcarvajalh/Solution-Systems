---
import Container from "@components/layout/Container.astro";
import Button from "@components/ui/Button.astro";
import { headerActions } from "@config/navigation";

interface Props {
  /** Nombre del producto; solo cambia el titular del hero. */
  productName: string;
}

const { productName } = Astro.props;

// TODO: confirmar con Juan — copy real por producto (intro y bloques de features).
const intro =
  "Desarrollamos soluciones tecnológicas para bancos, cooperativas y fondos, combinando experiencia, cercanía y respaldo técnico especializado.";

interface Feature {
  title: string;
  text: string;
  /** Lado de la imagen en escritorio; en móvil siempre va arriba. */
  imageSide: "left" | "right";
}

const features: Feature[] = [
  { title: "Controla matrices", text: intro, imageSide: "left" },
  { title: "Genera informes", text: intro, imageSide: "right" },
  { title: "Crea mapas de procesos", text: intro, imageSide: "left" },
];

const cta = headerActions.primary; // "Empezar ahora"

// Placeholders de imagen (recuadros grises) pendientes de fotos reales.
const placeholderBox = "flex items-center justify-center bg-section-secondary";
const placeholderMarker =
  "border-hairline text-ink-secondary/60 rounded border border-dashed px-3 py-1.5 text-xs tracking-wide uppercase";
---

{/* Hero */}
<section
  class="ss-rails border-hairline border-t bg-white"
  aria-labelledby="producto-heading"
>
  <div class="border-hairline border-b">
    <Container class="py-16 text-center lg:py-24">
      <h1
        id="producto-heading"
        class="text-display text-ink font-semibold"
      >
        {productName}
      </h1>
      <p class="text-lead text-ink-secondary mx-auto mt-6 max-w-[813px] font-medium">
        {intro}
      </p>
      <div class="mt-8 flex justify-center">
        <Button variant="primary" size="md" href={cta.href}>
          {cta.label}
        </Button>
      </div>
    </Container>
  </div>

  {/* Galería de miniaturas (placeholders) */}
  <div>
    <Container class="py-10 lg:py-12">
      <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
        {
          Array.from({ length: 4 }).map(() => (
            <li class:list={[placeholderBox, "aspect-[252/163]"]} aria-hidden="true">
              <span class={placeholderMarker}>Imagen</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>
</section>

{/* Bloques de características */}
<section class="ss-rails bg-surface-muted pb-24 lg:pb-36">
  <div class="space-y-10 lg:space-y-36">
    {
      features.map((feature) => (
        // Banda full-width: los bordes superior/inferior (hairline) cruzan toda
        // la pantalla; la tarjeta blanca se centra al ancho del rail-frame.
        <div class="border-hairline border-y">
          <article class="nav:max-w-[var(--rail-frame)] mx-auto w-full bg-white">
            <div class="flex flex-col lg:flex-row lg:items-stretch">
              {/* Imagen (placeholder) */}
              <div
                class:list={[
                  "border-hairline p-3 lg:w-[54%] lg:shrink-0",
                  feature.imageSide === "left"
                    ? "lg:border-r"
                    : "lg:order-2 lg:border-l",
                ]}
              >
                <div
                  class:list={[placeholderBox, "aspect-[595/370] w-full"]}
                  aria-hidden="true"
                >
                  <span class={placeholderMarker}>Imagen</span>
                </div>
              </div>

              {/* Texto */}
              <div class="flex flex-1 flex-col items-start justify-center gap-6 px-8 py-10 lg:px-12 lg:py-12">
                <h2 class="text-ink text-[2rem] leading-[1.2] font-semibold tracking-[-0.04em] sm:text-[2.5rem] sm:leading-[1.3]">
                  {feature.title}
                </h2>
                <p class="text-lead text-ink-secondary max-w-[414px] font-medium">
                  {feature.text}
                </p>
                <Button variant="primary" size="md" href={cta.href}>
                  {cta.label}
                </Button>
              </div>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>
