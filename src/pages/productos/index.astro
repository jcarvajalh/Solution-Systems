---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import { products, productHref } from "@config/navigation";

// TODO: diseñar el índice de productos (rejilla). Por ahora, lista de enlaces.
---

<BaseLayout
  title="Productos"
  description="Catálogo de productos de Solution Systems para el sector financiero."
>
  <Container class="py-16">
    <h1 class="text-display text-ink font-semibold">Productos</h1>
    <ul role="list" class="mt-8 flex flex-col gap-3">
      {
        products.map((product) => (
          <li>
            <a
              href={productHref(product)}
              class="text-lead text-brand font-medium underline-offset-4 hover:underline"
              {...(product.externalUrl
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {product.name}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</BaseLayout>
