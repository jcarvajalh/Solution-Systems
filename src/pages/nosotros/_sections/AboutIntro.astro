---
import { Image } from "astro:assets";
import Container from "@components/layout/Container.astro";

/*
  Iconos de las cifras resueltos por slug: al soltar `experiencia.png`,
  `clientes.png` o `usuarios.png` (png/jpg/webp/svg) en src/assets/images/about/
  aparecen dentro de su recuadro; mientras no existan se muestra un marcador
  (mismo patrón que ServiceCards/ClientLogos).
*/
const iconFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/about/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);
const iconBySlug = new Map(
  Object.entries(iconFiles).map(([path, mod]) => [
    path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, ""),
    mod.default,
  ]),
);

interface Stat {
  /** Cifra destacada (ej. "+26 años de experiencia"). */
  value: string;
  /** Texto de apoyo bajo la cifra. */
  label: string;
  /** Nombre del archivo del icono en src/assets/images/about/, sin extensión. */
  icon: string;
}

// Cifras reales (contenido.md §2).
const stats: Stat[] = [
  {
    value: "+26 años de experiencia",
    label: "Ayudando a organizaciones a crecer.",
    icon: "experiencia",
  },
  {
    value: "+30 clientes",
    label: "Con presencia en 15 departamentos de Colombia.",
    icon: "clientes",
  },
  {
    value: "+300 usuarios activos",
    label: "Actualmente nuestros sistemas los usan más de 300 usuarios.",
    icon: "usuarios",
  },
];

// Historia real de la empresa (contenido.md §2), en dos párrafos.
const history = [
  "Solution Systems nació con el propósito de acompañar a las organizaciones en la modernización de sus procesos. Desde entonces hemos desarrollado dos soluciones integrales: IAS, un ERP con módulos financieros, de captaciones y colocaciones, y de recurso humano; y RISK, una plataforma para la gestión de riesgos financieros.",
  "Con 26 años de trayectoria, hemos construido nuestras soluciones sobre tecnología Oracle —base de datos Oracle e interfaz en Oracle Apex— y hoy complementamos nuestros productos con servicios en la nube (OCI), mesa de ayuda, bolsas de horas para ajustes y análisis de procesos financieros y administrativos.",
];

/*
  Mapa de fondo de la línea de tiempo (placeholder): al soltar `mapa-mundi.png`
  (png/jpg/webp/svg) en src/assets/images/about/ aparece atenuado detrás de los
  hitos; mientras no exista se muestra un marcador.
*/
const mapImage = Object.entries(iconFiles).find(([path]) =>
  path.includes("mapa-mundi"),
)?.[1].default;

interface Milestone {
  year: string;
  text: string;
  /** Desfase vertical del hito en escritorio (efecto escalonado del diseño). */
  offset: string;
}

/*
  Hitos reales (contenido.md §2).
  TODO: confirmar con Juan — el año de fundación (2000) figura entre corchetes en
  el contenido, pendiente de validar.
*/
const milestones: Milestone[] = [
  {
    year: "2000",
    text: "Fundación de Solution Systems.",
    offset: "lg:mt-[297px]",
  },
  {
    year: "2008",
    text: "Lanzamiento de las primeras versiones de nuestro ERP.",
    offset: "lg:mt-[173px]",
  },
  {
    year: "2018",
    text: "Incorporación de servicios en la nube.",
    offset: "lg:mt-[271px]",
  },
  {
    year: "2021",
    text: "Lanzamiento de RISK solution.",
    offset: "lg:mt-[190px]",
  },
  {
    year: "2023",
    text: "Integración de procesos automatizados (RPA).",
    offset: "lg:mt-[300px]",
  },
  {
    year: "2025",
    text: "Incorporación de inteligencia artificial (IA) en nuestros productos y servicios.",
    offset: "lg:mt-[150px]",
  },
];
---

<section class="border-hairline border-t bg-white" aria-labelledby="nosotros-heading">
  <div class="ss-rails">
    {/* Bloque superior: titular + intro */}
  <div class="border-hairline border-b">
    <Container class="py-16 lg:pt-[7.125rem] lg:pb-[2.625rem]">
      <h1 id="nosotros-heading" class="text-display font-semibold text-ink">
        Somos Solution Systems
      </h1>
      <p class="text-lead text-ink-secondary mt-8 max-w-[609px] font-medium">
        Desarrollamos soluciones tecnológicas que combinan 26 años de
        experiencia, cercanía y respaldo técnico especializado.
      </p>
    </Container>
  </div>

  {/* Banda de cifras */}
  <div class="border-hairline bg-surface-muted border-b">
    <Container class="py-12 lg:py-10">
      <ul
        role="list"
        class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6"
      >
        {
          stats.map((stat) => {
            const icon = iconBySlug.get(stat.icon);

            return (
              <li class="flex flex-col items-center text-center">
                <span class="bg-section-secondary rounded-control flex size-14 items-center justify-center">
                  {icon ? (
                    // TODO: describir el icono en `alt` al reemplazar el placeholder.
                    <Image src={icon} alt="" class="size-[38px] object-contain" />
                  ) : (
                    <span
                      class="border-ink/20 size-[38px] rounded-md border border-dashed"
                      aria-hidden="true"
                    />
                  )}
                </span>
                <p class="text-ink mt-5 text-[1.5rem] leading-[1.29] font-semibold tracking-[-0.04em]">
                  {stat.value}
                </p>
                <p class="text-ink-secondary mt-3 max-w-[248px] text-[1.125rem] leading-[1.39] font-medium tracking-[-0.04em]">
                  {stat.label}
                </p>
              </li>
            );
          })
        }
      </ul>
    </Container>
  </div>

  {/* Bloque inferior: nuestra historia */}
  <div class="border-hairline border-b">
    <Container class="py-12 lg:pt-[1.625rem] lg:pb-16">
      <h2 class="text-ink text-[1.75rem] leading-[1.2] font-semibold tracking-[-0.04em] sm:text-[2rem] sm:leading-[1.31]">
        Nuestra historia
      </h2>
      <div class="mt-6 max-w-[1047px] space-y-5">
        {history.map((paragraph) => (
          <p class="text-lead text-ink-secondary font-medium">{paragraph}</p>
        ))}
      </div>
    </Container>
  </div>
  </div>

  {/* Línea de tiempo sobre el mapamundi */}
  <div class="relative overflow-hidden border-hairline border-b bg-white">
    {/* Mapamundi de fondo (solo escritorio) */}
    <div
      class="pointer-events-none absolute inset-0 z-0 hidden items-center justify-center lg:flex"
      aria-hidden="true"
    >
      {
        mapImage ? (
          <Image
            src={mapImage}
            alt=""
            class="h-full w-full object-contain opacity-[0.59]"
          />
        ) : (
          <span class="border-hairline text-ink-secondary/60 rounded-md border border-dashed px-6 py-4 text-sm tracking-wide uppercase">
            mapa-mundi
          </span>
        )
      }
    </div>

    <Container class="relative z-10 py-16 lg:py-0">
      <ol
        class="border-brand flex flex-col gap-10 border-l-2 pl-6 lg:h-[640px] lg:flex-row lg:gap-6 lg:border-l-0 lg:pl-0"
        aria-label="Línea de tiempo de Solution Systems"
      >
        {
          milestones.map((m) => (
            <li class="flex flex-col lg:flex-1">
              <div class:list={[m.offset]}>
                <p class="text-brand font-mono text-[1.5rem] leading-[1.33] font-medium tracking-[-0.02em]">
                  {m.year}
                </p>
                <p class="text-ink mt-2 max-w-[15rem] text-xs leading-[1.33] tracking-[-0.02em]">
                  {m.text}
                </p>
              </div>
              {/* Línea vertical que cae hasta el borde inferior (solo escritorio). */}
              <span
                class="bg-brand mt-4 hidden w-0.5 flex-1 lg:block"
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ol>
    </Container>
  </div>
</section>
