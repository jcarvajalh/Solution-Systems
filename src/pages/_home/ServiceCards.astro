---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import Container from "@components/layout/Container.astro";

/*
  Las ilustraciones de cada tarjeta se resuelven por slug de archivo: al soltar
  `servicios-nube.png` en src/assets/images/services/ aparece automáticamente.
  Mientras el archivo no exista se pinta un marcador con el slug, para que el
  build no rompa y quede claro qué imagen falta (mismo patrón que ClientLogos).
*/
const illustrations = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/services/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);

const illustrationBySlug = new Map(
  Object.entries(illustrations).map(([path, mod]) => [
    path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, ""),
    mod.default,
  ]),
);

interface ServiceCard {
  title: string;
  description: string;
  /** Slug del archivo de la ilustración en src/assets/images/services/. */
  illustration: string;
  /** Tarjeta central resaltada del diseño. */
  featured?: boolean;
}

// Texto tal cual el diseño de Figma (incluida la tarjeta central destacada).
const cards: ServiceCard[] = [
  {
    title: "Servicios en la nube",
    description:
      "Infraestructura Oracle Cloud en modalidad SaaS o IaaS, con niveles de servicio adaptados a tu operación.",
    illustration: "servicios-nube",
  },
  {
    title: "Servicios en la nube",
    description:
      "Infraestructura Oracle Cloud en modalidad SaaS o IaaS, con niveles de servicio adaptados a tu operación.",
    illustration: "servicios-nube",
    featured: true,
  },
  {
    title: "Mesa de ayuda",
    description:
      "Infraestructura Oracle Cloud en modalidad SaaS o IaaS, con niveles de servicio adaptados a tu operación.",
    illustration: "mesa-ayuda",
  },
];
---

<section
  class="ss-rails bg-white py-14 lg:py-[53px]"
  aria-labelledby="servicios-heading"
>
  <Container>
    <div class="mx-auto max-w-[888px]">
      <h2
        id="servicios-heading"
        class="text-ink text-[2rem] leading-tight font-semibold tracking-[-0.04em] sm:text-[2.5rem] lg:text-[3rem] lg:leading-[1.29]"
      >
        Nuestros servicios
      </h2>

      <p
        class="text-ink-secondary mt-[18px] max-w-[670px] text-[1.125rem] leading-[1.28] font-normal tracking-[-0.04em]"
      >
        Ofrecemos servicios en la nube sobre infraestructura Oracle Cloud,
        disponibles en modalidad SaaS o IaaS y con niveles de servicio adaptados
        a las necesidades de su operación. Complementamos esta infraestructura
        con una mesa de ayuda de soporte técnico multicanal.
      </p>

      <ul
        role="list"
        class="ss-scroll-x mt-14 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 lg:grid lg:grid-cols-3 lg:items-start lg:gap-[9px] lg:overflow-visible lg:pb-0"
      >
        {
          cards.map((card) => {
            const image = illustrationBySlug.get(card.illustration);

            return (
              <li
                class:list={[
                  "flex shrink-0 basis-[78%] snap-start sm:basis-[45%] lg:basis-auto lg:shrink lg:snap-align-none",
                  card.featured && "lg:-mt-[17px]",
                ]}
              >
                <a
                  href="/soluciones"
                  class:list={[
                    "group flex w-full cursor-pointer flex-col rounded-[10px] p-7 outline-none transition duration-200 ease-out hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current motion-reduce:transform-none",
                    card.featured
                      ? "bg-brand hover:shadow-brand/25 text-white hover:shadow-xl lg:pb-[52px]"
                      : "text-ink bg-surface-muted hover:shadow-lg hover:shadow-black/5",
                  ]}
                >
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-[1.25rem] leading-[1.3] font-medium tracking-[-0.04em]">
                      {card.title}
                    </h3>
                    <Icon
                      name="lucide:arrow-up-right"
                      class="mt-1 size-5 shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none"
                      aria-hidden="true"
                    />
                  </div>

                  <p
                    class:list={[
                      "mt-[14px] max-w-[225px] text-[1.125rem] leading-[1.28] font-normal tracking-[-0.04em]",
                      card.featured ? "text-white/90" : "text-ink-secondary",
                    ]}
                  >
                    {card.description}
                  </p>

                  <div class="mt-auto pt-9">
                    {/* Marco de la ilustración; la imagen final entra por slug. */}
                    <div class="aspect-[234/197] overflow-hidden rounded-[10px] bg-white">
                      {image ? (
                        // TODO: describir la imagen en `alt` al reemplazar el placeholder.
                        <Image
                          src={image}
                          alt=""
                          class="size-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="flex size-full items-center justify-center p-4 text-center">
                          <span class="border-hairline text-ink-secondary/70 rounded border border-dashed px-2 py-1 text-[0.625rem] tracking-[-0.02em] uppercase">
                            {card.illustration}
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  /* Oculta la barra de scroll del carrusel móvil sin perder el desplazamiento
     táctil/por teclado. En lg el contenedor pasa a grid y esto es inocuo. */
  .ss-scroll-x {
    scrollbar-width: none;
  }
  .ss-scroll-x::-webkit-scrollbar {
    display: none;
  }
</style>
