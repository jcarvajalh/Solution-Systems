---
import Container from "@components/layout/Container.astro";

interface Stat {
  value: string;
  label: string;
}

// Cifras reales (contenido.md §1).
const stats: Stat[] = [
  {
    value: "26+",
    label:
      "Años de experiencia acompañando organizaciones en su transformación tecnológica.",
  },
  { value: "30+", label: "Clientes activos confían en Solution Systems." },
  { value: "300+", label: "Usuarios usan nuestros servicios." },
];
---

<section
  class="ss-rails border-hairline bg-surface-muted border-y py-16 lg:py-[95px]"
  aria-labelledby="cifras-heading"
>
  <Container>
    <div
      class="flex flex-col gap-y-10 lg:flex-row lg:items-start lg:justify-between lg:gap-x-[72px]"
    >
      <div class="lg:max-w-[304px]">
        <h2
          id="cifras-heading"
          class="text-ink text-[2.5rem] leading-[1.04] font-semibold tracking-[-0.02em] lg:text-[3rem]"
        >
          Nuestras Cifras
        </h2>
        <p
          class="text-ink-secondary mt-6 max-w-[265px] text-[1.125rem] leading-[1.28] font-normal tracking-[-0.02em]"
        >
          Te ayudamos a liberar el potencial de tu negocio.
        </p>
      </div>

      <ul
        role="list"
        class="grid grid-cols-3 gap-x-4 gap-y-10 sm:gap-x-6 lg:flex-1 lg:pt-[18px]"
      >
        {
          stats.map((stat) => (
            <li>
              <p class="text-brand text-[2rem] leading-none font-semibold tracking-[-0.02em] sm:text-[2.5rem] lg:text-[3rem]">
                {stat.value}
              </p>
              <p class="text-ink-secondary mt-3 max-w-[205px] text-[0.9375rem] leading-[1.28] font-medium tracking-[-0.02em] sm:mt-6 sm:text-[1.125rem]">
                {stat.label}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
