---
import { Icon } from "astro-icon/components";

import Container from "./Container.astro";
import Button from "@components/ui/Button.astro";
import { headerActions, mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";

const navLink = ["text-nav font-medium transition-colors", focusRing];
---

<header
  id="ss-header"
  class="bg-white sticky top-0 z-40 transition-transform duration-200 ease-out will-change-transform motion-reduce:transition-none"
>
  <Container class="flex h-[var(--header-height)] items-center">
    <a
      href="/"
      class="rounded-control focus-visible:outline-brand shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      <img
        src="/logo-solution-systems.png"
        alt={siteConfig.name}
        width="193"
        height="26"
        class="block h-[26px] w-[193px]"
      />
    </a>

    <nav class="nav:ml-25 nav:block hidden" aria-label="Principal">
      <ul class="flex items-center gap-10">
        {
          mainNav.map((item) => (
            <li class:list={["relative", item.dropdown && "group"]}>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                aria-haspopup={item.dropdown ? "true" : undefined}
                class:list={[
                  "ss-tap-target inline-flex items-center gap-1",
                  navLink,
                  isActive(item.href)
                    ? "text-brand"
                    : "text-ink hover:text-brand",
                ]}
              >
                {item.label}
                {item.hasDropdown && (
                  <Icon
                    name="lucide:chevron-down"
                    class="size-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 motion-reduce:transition-none"
                    aria-hidden="true"
                  />
                )}
              </a>

              {item.dropdown && (
                <div class="invisible absolute top-full left-0 z-50 pt-3 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 motion-reduce:transition-none">
                  <ul class="border-hairline rounded-control w-64 border bg-white p-2 shadow-lg shadow-black/5">
                    {item.dropdown.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class:list={[
                            "text-nav text-ink hover:bg-surface-muted hover:text-brand block rounded-md px-3 py-2 font-medium transition-colors",
                            focusRing,
                          ]}
                        >
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav:flex ml-auto hidden items-center gap-2.5">
      <Button variant="secondary" size="sm" href={headerActions.secondary.href}>
        {headerActions.secondary.label}
      </Button>
      <Button variant="primary" size="sm" href={headerActions.primary.href}>
        {headerActions.primary.label}
      </Button>
    </div>

    <button
      type="button"
      id="ss-nav-toggle"
      class:list={[
        "rounded-control text-ink nav:hidden ml-auto inline-flex size-11 items-center justify-center",
        focusRing,
      ]}
      aria-expanded="false"
      aria-controls="ss-nav-panel"
      aria-label="Abrir menú"
    >
      <Icon
        name="lucide:menu"
        class="size-6"
        data-icon="open"
        aria-hidden="true"
      />
      <Icon
        name="lucide:x"
        class="hidden size-6"
        data-icon="close"
        aria-hidden="true"
      />
    </button>
  </Container>

  <!-- Figma solo define el header a 1440px. El panel compacto es una decisión de
       implementación pendiente de validar contra un frame de diseño. -->
  <div id="ss-nav-panel" hidden class="border-ink/10 nav:hidden border-t">
    <Container class="py-4">
      <nav aria-label="Principal (móvil)">
        <ul class="flex flex-col">
          {
            mainNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "flex h-11 items-center justify-between",
                    navLink,
                    isActive(item.href)
                      ? "text-brand"
                      : "text-ink hover:text-brand",
                  ]}
                >
                  {item.label}
                  {item.hasDropdown && (
                    <Icon
                      name="lucide:chevron-down"
                      class="size-4"
                      aria-hidden="true"
                    />
                  )}
                </a>

                {item.dropdown && (
                  <ul class="border-ink/10 mb-2 flex flex-col border-l pl-4">
                    {item.dropdown.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class:list={[
                            "text-nav text-ink-secondary hover:text-brand flex h-10 items-center font-medium",
                            focusRing,
                          ]}
                        >
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-4 flex items-center gap-2.5">
        <Button
          variant="secondary"
          size="touch"
          href={headerActions.secondary.href}
          class="flex-1"
        >
          {headerActions.secondary.label}
        </Button>
        <Button
          variant="primary"
          size="touch"
          href={headerActions.primary.href}
          class="flex-1"
        >
          {headerActions.primary.label}
        </Button>
      </div>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById("ss-nav-toggle");
  const panel = document.getElementById("ss-nav-panel");

  if (toggle && panel) {
    const openIcon = toggle.querySelector('[data-icon="open"]');
    const closeIcon = toggle.querySelector('[data-icon="close"]');
    const desktop = window.matchMedia("(min-width: 72rem)");

    let isOpen = false;

    const setOpen = (open: boolean) => {
      isOpen = open;
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(!isOpen));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) {
        setOpen(false);
        toggle.focus();
      }
    });

    // El panel no existe a partir de `nav`: al ensanchar la ventana debe quedar cerrado.
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Auto-ocultar el header al bajar y mostrarlo al subir (transición rápida).
  const header = document.getElementById("ss-header");
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const DELTA = 6; // ignora micro-scrolls para que no parpadee

    const update = () => {
      ticking = false;
      const y = Math.max(window.scrollY, 0);
      // Con el menú móvil abierto el header siempre queda visible.
      const menuOpen = panel && !panel.hidden;
      if (Math.abs(y - lastY) < DELTA && y > header.offsetHeight) return;

      if (y > lastY && !menuOpen && y > header.offsetHeight) {
        header.classList.add("-translate-y-full"); // bajando: ocultar
      } else {
        header.classList.remove("-translate-y-full"); // subiendo: mostrar
      }
      lastY = y;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
