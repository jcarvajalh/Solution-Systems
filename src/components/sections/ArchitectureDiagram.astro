---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

/*
  Diagrama de arquitectura de la plataforma IAS (Figma, Group 161 y aledaños).
  Es un gráfico auto-contenido: se reconstruye con las MISMAS coordenadas del
  diseño (espacio local 746×320, origen trasladado al nodo superior-izquierdo).
  - Nodos: HTML posicionado en % dentro de un contenedor con `aspect-ratio`.
  - Flechas: SVG con `viewBox` sobre el mismo espacio, con punta (marker).
  Todo escala junto vía container queries (`cqw`); en móvil el bloque conserva
  un ancho mínimo y se desplaza en horizontal para no encoger el texto.

  Coordenadas y tiempos se inyectan como custom properties (datos), no como
  estilos sueltos: las declaraciones viven en el <style> (§5.3). Los tintes de la
  animación derivan de `--color-brand` con `color-mix` (§12.3). El bloque global
  de `prefers-reduced-motion` (global.css) neutraliza el ciclo; el diagrama queda
  legible estático.
*/

interface Node {
  label: string;
  /** left, top, width, height en % del contenedor + retardo de pulso. */
  l: string;
  t: string;
  w: string;
  h: string;
  pd: string;
}

const accessNodes: Node[] = [
  { label: "Navegadores", l: "22.92%", t: "2.19%", w: "17.29%", h: "14.69%", pd: "0s" },
  { label: "Usuarios", l: "41.96%", t: "2.19%", w: "14.61%", h: "14.69%", pd: "0.1s" },
  { label: "Acceso web", l: "57.91%", t: "2.19%", w: "17.29%", h: "14.69%", pd: "0.2s" },
];

// Ancho ampliado (16.5%) y mismo centro que en Figma, para que "Módulo IAS"
// entre en una sola línea en las tres cajas.
const moduleNodes: Node[] = [
  { label: "Módulo IAS", l: "25.00%", t: "87.19%", w: "16.50%", h: "12.81%", pd: "1.5s" },
  { label: "Módulo IAS", l: "42.62%", t: "87.19%", w: "16.50%", h: "12.81%", pd: "1.6s" },
  { label: "Módulo IAS", l: "60.25%", t: "87.19%", w: "16.50%", h: "12.81%", pd: "1.7s" },
];

// Íconos de monitoreo del nodo (rejilla 2×2). Iconografía genérica (lucide),
// no activos de marca.
const monitorIcons = [
  "lucide:network",
  "lucide:globe",
  "lucide:hourglass",
  "lucide:monitor-check",
] as const;

// Flechas del flujo: `d` en coordenadas locales, `fd` retardo de la animación.
const arrows = [
  { d: "M235.5,54 V95 H345 V112", fd: "0s" }, // Navegadores → IAS
  { d: "M367.5,54 V112", fd: "0.1s" }, // Usuarios → IAS
  { d: "M496.5,54 V95 H390 V112", fd: "0.2s" }, // Acceso web → IAS
  { d: "M693.5,74 V30 H561", fd: "0.35s" }, // Rejilla → Acceso web
  { d: "M140,156 H313", fd: "0.6s" }, // AWS → IAS
  { d: "M539,150 H424", fd: "0.65s" }, // Base de datos → IAS
  { d: "M367.5,221 V250 H248 V279", fd: "1.1s" }, // IAS → Módulo 1
  { d: "M367.5,221 V250 H379.5 V279", fd: "1.2s" }, // IAS → Módulo 2
  { d: "M367.5,221 V250 H511 V279", fd: "1.3s" }, // IAS → Módulo 3
  { d: "M693.5,169 V284", fd: "1.55s" }, // Rejilla → Soporte
] as const;

/*
  Imágenes por nombre de archivo en src/assets/images/solutions/ (mismo patrón
  que ServiceCards). Mientras el archivo no exista se pinta el placeholder.
*/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/solutions/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);
const imageBySlug = new Map(
  Object.entries(images).map(([path, mod]) => [
    path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, ""),
    mod.default,
  ]),
);
const awsImg = imageBySlug.get("aws");
const dbImg = imageBySlug.get("db");

export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={["ss-diagram-scroll", className]}>
  <figcaption class="sr-only">
    Arquitectura de la plataforma IAS: los usuarios acceden desde navegadores y
    acceso web a la plataforma IAS, desplegada sobre infraestructura cloud AWS y
    bases de datos Oracle, que habilita los módulos IAS y la mesa de ayuda.
  </figcaption>

  <div class="ss-diagram">
    {/* Flechas del flujo (detrás de los nodos) */}
    <svg
      class="ss-arrows"
      viewBox="0 0 746 320"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <marker
          id="ss-arrowhead"
          markerUnits="userSpaceOnUse"
          markerWidth="12"
          markerHeight="12"
          viewBox="0 0 12 12"
          refX="9"
          refY="6"
          orient="auto-start-reverse"
        >
          <path d="M1,1 L11,6 L1,11 Z" fill="var(--color-ink)"></path>
        </marker>
      </defs>

      <g class="ss-base">
        {arrows.map((a) => <path d={a.d} marker-end="url(#ss-arrowhead)" />)}
      </g>

      <g class="ss-flows">
        {
          arrows.map((a) => (
            <path
              class="ss-flow"
              d={a.d}
              pathLength="100"
              style={`--fd:${a.fd}`}
            />
          ))
        }
      </g>
    </svg>

    {/* Nodos de acceso */}
    {
      accessNodes.map((n) => (
        <div
          class="ss-dnode ss-node-box"
          style={`--l:${n.l};--t:${n.t};--w:${n.w};--h:${n.h};--pd:${n.pd}`}
        >
          {n.label}
        </div>
      ))
    }

    {/* Núcleo IAS */}
    <div
      class="ss-dnode ss-node-box ss-ias"
      style="--l:41.96%;--t:35.00%;--w:14.61%;--h:34.06%;--pd:0.9s"
    >
      IAS
    </div>

    {/* AWS */}
    <div
      class:list={["ss-dnode", awsImg ? "ss-imgnode" : "ss-ph"]}
      style="--l:9.38%;--t:41.88%;--w:9.38%;--h:13.75%"
      aria-hidden="true"
    >
      {
        awsImg ? (
          <Image src={awsImg} alt="" class="ss-node-img" loading="lazy" decoding="async" />
        ) : (
          <Icon name="lucide:image" class="ss-ph-icon" />
        )
      }
    </div>

    {/* Infraestructura Cloud AWS */}
    <div
      class="ss-dnode ss-node-box"
      style="--l:0%;--t:59.38%;--w:28.15%;--h:23.13%;--pd:0.7s"
    >
      Infraestructura Cloud AWS
    </div>

    {/* Base de datos */}
    <div
      class:list={["ss-dnode", dbImg ? "ss-imgnode" : "ss-ph"]}
      style="--l:72.25%;--t:35.94%;--w:5.63%;--h:14.69%"
      aria-hidden="true"
    >
      {
        dbImg ? (
          <Image src={dbImg} alt="" class="ss-node-img" loading="lazy" decoding="async" />
        ) : (
          <Icon name="lucide:image" class="ss-ph-icon" />
        )
      }
    </div>

    {/* Bases de Datos Oracle */}
    <div
      class="ss-dnode ss-node-box"
      style="--l:64.75%;--t:53.44%;--w:20.64%;--h:20.94%;--pd:0.7s"
    >
      Bases de Datos Oracle
    </div>

    {/* Módulos */}
    {
      moduleNodes.map((n) => (
        <div
          class="ss-dnode ss-node-box"
          style={`--l:${n.l};--t:${n.t};--w:${n.w};--h:${n.h};--pd:${n.pd}`}
        >
          {n.label}
        </div>
      ))
    }

    {/* Rejilla de monitoreo 2×2 */}
    <div
      class="ss-dnode ss-grid-box"
      style="--l:86.60%;--t:23.13%;--w:12.73%;--h:29.69%"
      aria-hidden="true"
    >
      <div class="ss-grid-inner">
        {
          monitorIcons.map((name) => (
            <span class="ss-brick">
              <Icon name={name} class="ss-brick-icon" />
            </span>
          ))
        }
      </div>
    </div>

    {/* Soporte */}
    <div
      class="ss-dnode ss-node-box"
      style="--l:86.60%;--t:88.75%;--w:13.40%;--h:10.63%;--pd:1.9s"
    >
      Soporte
    </div>
  </div>
</figure>

<style>
  /* En móvil el diagrama conserva su ancho mínimo y se desplaza; en escritorio
     se centra a su tamaño de diseño. */
  .ss-diagram-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ss-diagram-scroll::-webkit-scrollbar {
    display: none;
  }

  .ss-diagram {
    container-type: inline-size;
    position: relative;
    width: 100%;
    min-width: 600px;
    max-width: 760px;
    margin-inline: auto;
    aspect-ratio: 746 / 320;
    --ss-cycle: 5s;
  }

  .ss-arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Flechas base: sólidas, como en Figma. */
  .ss-base path {
    stroke: var(--color-ink);
    stroke-width: 1.4;
    fill: none;
  }

  /* Cometa de flujo que recorre cada flecha. */
  .ss-flow {
    stroke: var(--color-brand);
    stroke-width: 2.4;
    stroke-linecap: round;
    fill: none;
    stroke-dasharray: 10 100;
    stroke-dashoffset: 100;
    opacity: 0;
    animation: ss-flow var(--ss-cycle) linear infinite;
    animation-delay: var(--fd, 0s);
  }

  .ss-dnode {
    position: absolute;
    left: var(--l);
    top: var(--t);
    width: var(--w);
    height: var(--h);
  }

  .ss-node-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6cqw;
    text-align: center;
    font-size: 2.68cqw;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    background-color: transparent;
    border: 1px dashed var(--color-brand);
    border-radius: 0.67cqw;
    animation: ss-dnode-pulse var(--ss-cycle) ease-in-out infinite;
    animation-delay: var(--pd, 0s);
  }

  .ss-ias {
    font-size: 5.36cqw;
    line-height: 1;
    border-radius: 1.34cqw;
  }

  /* Placeholder de imagen (logo AWS, ícono de base de datos). */
  .ss-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fff;
    border: 1px dashed color-mix(in srgb, var(--color-brand) 50%, transparent);
    border-radius: 0.67cqw;
    color: color-mix(in srgb, var(--color-brand) 60%, transparent);
  }
  .ss-ph :global(.ss-ph-icon) {
    width: 2.4cqw;
    height: 2.4cqw;
  }

  /* Nodo con imagen real: el logo va suelto, centrado, sin marco (Figma). */
  .ss-imgnode {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ss-imgnode :global(.ss-node-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Rejilla de monitoreo. */
  .ss-grid-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.8cqw;
    border: 1px dashed var(--color-brand);
    border-radius: 1.34cqw;
  }
  .ss-grid-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8cqw;
  }
  .ss-brick {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4cqw;
    height: 4.4cqw;
    background-color: var(--color-brand);
    border-radius: 0.67cqw;
    color: #fff;
    animation: ss-brick-pop var(--ss-cycle) ease-in-out infinite;
  }
  .ss-brick:nth-child(1) {
    animation-delay: 1.9s;
  }
  .ss-brick:nth-child(2) {
    animation-delay: 1.98s;
  }
  .ss-brick:nth-child(3) {
    animation-delay: 2.06s;
  }
  .ss-brick:nth-child(4) {
    animation-delay: 2.14s;
  }
  .ss-brick :global(.ss-brick-icon) {
    width: 2.9cqw;
    height: 2.9cqw;
  }

  @keyframes ss-flow {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    40% {
      stroke-dashoffset: -10;
      opacity: 1;
    }
    46%,
    100% {
      stroke-dashoffset: -10;
      opacity: 0;
    }
  }

  @keyframes ss-dnode-pulse {
    0%,
    20%,
    100% {
      background-color: transparent;
      box-shadow: 0 0 0 0 transparent;
    }
    6% {
      background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
      box-shadow: 0 0 0 0.5cqw color-mix(in srgb, var(--color-brand) 16%, transparent);
    }
  }

  @keyframes ss-brick-pop {
    0%,
    30%,
    100% {
      transform: scale(1);
      opacity: 0.85;
    }
    12% {
      transform: scale(1.12);
      opacity: 1;
    }
  }
</style>
