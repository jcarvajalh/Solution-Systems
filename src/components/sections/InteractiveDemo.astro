---
import { getImage } from "astro:assets";

import { InteractiveApp } from "@features/interactive-app";
import appBackdrop from "@assets/images/app-backdrop.jpg";

// Se optimiza aquí porque `<Image>` es un componente de Astro y no puede
// renderizarse dentro de la isla de React.
const backdrop = await getImage({
  src: appBackdrop,
  format: "webp",
  width: 1056,
});
---

<section class="bg-surface-muted pt-6 pb-3.5">
  <h2 class="sr-only">Recorre los módulos de la plataforma</h2>
  <InteractiveApp backdropSrc={backdrop.src} client:visible />
</section>
