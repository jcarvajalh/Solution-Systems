---
import { Image } from "astro:assets";

interface Props {
  name: string;
  role: string;
  /** Foto ya resuelta; ausente muestra el marcador con iniciales. */
  photo?: ImageMetadata;
  /** Chip resaltado con color de marca (primera tarjeta del diseño). */
  featured?: boolean;
}

const { name, role, photo, featured = false } = Astro.props;

const initials = name
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0] ?? "")
  .join("")
  .toUpperCase();
---

<article class="relative">
  <div class="bg-section-secondary aspect-[227/255] overflow-hidden rounded-[20px]">
    {
      photo ? (
        <Image
          src={photo}
          alt={name}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex size-full items-center justify-center">
          <span class="text-ink-secondary/60 text-2xl font-semibold tracking-tight">
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <div
    class:list={[
      "rounded-control absolute inset-x-4 bottom-4 px-4 py-2.5 shadow-sm",
      featured ? "bg-brand text-white" : "text-ink bg-white",
    ]}
  >
    <p class="text-[1.25rem] leading-[1.3] font-medium tracking-[-0.04em]">
      {name}
    </p>
    <p class="text-[0.875rem] leading-[1.29] font-normal tracking-[-0.04em]">
      {role}
    </p>
  </div>
</article>
