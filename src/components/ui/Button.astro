---
export interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  data-variant={variant}
  data-size={size}
>
  <slot />
</Tag>
