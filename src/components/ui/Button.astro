---
import type { HTMLAttributes } from "astro/types";

/** Solo las variantes que existen en Figma. */
type Variant = "primary" | "secondary";
/**
 * `sm` = header (28px) y `md` = hero (36px), ambos de Figma.
 * `touch` no está en el diseño: es el tamaño del menú compacto, donde el área
 * táctil mínima de 44px sí cabe sin romper la composición.
 */
type Size = "sm" | "md" | "touch";

export interface Props extends Omit<HTMLAttributes<"a">, "type"> {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: "button" | "submit" | "reset";
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const base =
  "inline-flex items-center justify-center rounded-control text-action font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";

const variants: Record<Variant, string> = {
  primary: "bg-brand text-white hover:brightness-110",
  secondary: "border border-brand text-brand hover:bg-brand hover:text-white",
};

const sizes: Record<Size, string> = {
  sm: "ss-tap-target h-7 px-3",
  md: "ss-tap-target h-9 px-5.5",
  touch: "h-11 px-5.5",
};
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[base, variants[variant], sizes[size], className]}
  {...rest}
>
  <slot />
</Tag>
